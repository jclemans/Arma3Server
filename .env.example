ARMA_BINARY=./arma3server_x64
ARMA_CDLC=
ARMA_CONFIG=main.cfg
ARMA_LIMITFPS=100
ARMA_PARAMS=
ARMA_PROFILE=main
ARMA_WORLD=empty
HEADLESS_CLIENTS=0
HEADLESS_CLIENTS_PROFILE="\$profile-hc-\$i" # valid placeholders: $profile, $i, $ii
MODS_LOCAL=true
MODS_PRESET=
PORT=2302
# Optional. Empty = public, or creatordlc when ARMA_CDLC is set.
STEAM_BRANCH=
STEAM_BRANCH_PASSWORD=
# Required only when MODS_PRESET is set. Account must own Arma 3.
# Do not set a password here — bootstrap Steam Guard once (see README).
STEAM_USER=id-not-email
