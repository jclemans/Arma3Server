ARMA_BINARY=./arma3server_x64
ARMA_CDLC=
ARMA_CONFIG=main.cfg
ARMA_LIMITFPS=100
ARMA_PARAMS=
ARMA_PROFILE=main
ARMA_WORLD=empty
HEADLESS_CLIENTS=0
# Valid placeholders: $profile, $i, $ii
HEADLESS_CLIENTS_PROFILE="\$profile-hc-\$i"
MODS_LOCAL=true
# An Arma 3 Launcher preset, as a local path or URL.
MODS_PRESET=
# Workshop IDs, separated by semicolons. Workshop URLs also work.
MODS_WORKSHOP=
# Hardlink workshop mods into the server instead of copying them. Saves disk
# on large mod sets; needs the Steam and server directories on one filesystem.
MODS_LINK=false
PORT=2302
# Owner for the mounted configs, mods, servermods, and mpmissions directories,
# so your host user can edit them and read RPT logs. The server runs as root
# either way. Leave both empty to keep root ownership.
PUID=
PGID=
# Optional. Empty = public, or creatordlc when ARMA_CDLC is set.
STEAM_BRANCH=
STEAM_BRANCH_PASSWORD=
# Steam account name (not an email) that owns Arma 3. Used for Workshop
# downloads and, when a token has been bootstrapped, the server install.
# Do not set a password here — run `docker compose run --rm arma3 bootstrap`.
STEAM_USER=id-not-email
# Alternative to the interactive bootstrap for hosts with no terminal:
# base64 config.vdf from `docker compose run --rm arma3 export-auth`.
# This is a secret. Prefer the steam-auth volume where you can use it.
STEAM_AUTH_VDF_B64=
