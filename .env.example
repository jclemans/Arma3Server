ARMA_BINARY=./arma3server_x64
ARMA_CDLC=
ARMA_CONFIG=main.cfg
ARMA_LIMITFPS=100
ARMA_PARAMS=
ARMA_PROFILE=main
ARMA_WORLD=empty
HEADLESS_CLIENTS=0
# Valid placeholders: $profile, $i, $ii
HEADLESS_CLIENTS_PROFILE="\$profile-hc-\$i"
MODS_LOCAL=true
MODS_PRESET=
PORT=2302
# Optional. Empty = public, or creatordlc when ARMA_CDLC is set.
STEAM_BRANCH=
STEAM_BRANCH_PASSWORD=
# Steam account name (not an email) that owns Arma 3. Used for Workshop
# downloads and, when a token has been bootstrapped, the server install.
# Do not set a password here — run `docker compose run --rm arma3 bootstrap`.
STEAM_USER=id-not-email
# Alternative to the interactive bootstrap for hosts with no terminal:
# base64 config.vdf from `docker compose run --rm arma3 export-auth`.
# This is a secret. Prefer the steam-auth volume where you can use it.
STEAM_AUTH_VDF_B64=
